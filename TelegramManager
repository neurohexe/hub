const TelegramManager = (function() {

  const PROP_BOT_TOKEN = 'TELEGRAM_BOT_TOKEN';
  const PROP_CHAT_ID   = 'TELEGRAM_CHAT_ID';
  const PROP_THREAD_ID = 'TELEGRAM_THREAD_ID';

  function getBotToken() {
    const token = PropertiesService.getScriptProperties().getProperty(PROP_BOT_TOKEN);
    if (!token) {
      throw new Error(
        'Токен Telegram-бота не настроен!\n\n' +
        'Перейдите: ⚙️ Настройки → 🔗 Настроить Telegram'
      );
    }
    return token;
  }

  function saveBotToken(token) {
    if (!token || token.trim() === '') throw new Error('Токен не может быть пустым');
    PropertiesService.getScriptProperties().setProperty(PROP_BOT_TOKEN, token.trim());
    Logger.log('✅ Токен бота сохранён');
  }

  function getChatId() {
    const saved = PropertiesService.getScriptProperties().getProperty(PROP_CHAT_ID);
    if (saved && saved !== 'Не подключён') return saved;

    try {
      const ss    = SpreadsheetApp.getActiveSpreadsheet();
      const sheet = ss.getSheetByName('Базовая информация');
      if (sheet) {
        const data = sheet.getDataRange().getValues();
        for (let i = 0; i < data.length; i++) {
          if (data[i][0] && data[i][0].toString().trim() === 'Chat ID логистики:') {
            const chatId = data[i][1] ? data[i][1].toString().trim() : '';
            if (chatId && chatId !== 'Не подключён') {
              PropertiesService.getScriptProperties().setProperty(PROP_CHAT_ID, chatId);
              return chatId;
            }
          }
        }
      }
    } catch(e) {
      Logger.log('⚠️ getChatId (из листа): ' + e.toString());
    }

    throw new Error(
      'Telegram чат не подключён!\n\n' +
      'Перейдите: ⚙️ Настройки → 🔗 Настроить Telegram'
    );
  }

  function getDefaultThreadId() {
    const v = PropertiesService.getScriptProperties().getProperty(PROP_THREAD_ID);
    return v ? v : null;
  }

  function setDefaultThreadId() {
    const ui = SpreadsheetApp.getUi();

    const res = ui.alert(
      '🧵 Общий чат — это тема внутри супергруппы?',
      'Если ваш общий чат логиста — это отдельная ТЕМА (топик)\n' +
      'внутри большой супергруппы с несколькими темами\n' +
      '(а НЕ отдельная группа/чат) — нажмите YES.\n\n' +
      'Если это обычная отдельная группа — нажмите NO.',
      ui.ButtonSet.YES_NO
    );

    if (res !== ui.Button.YES) {
      PropertiesService.getScriptProperties().deleteProperty(PROP_THREAD_ID);
      ui.alert('✅ Привязка к теме отключена.\n\nСообщения будут уходить в общий чат как обычно.');
      return;
    }

    const idRes = ui.prompt(
      '🧵 Thread ID темы',
      'Как получить:\n\n' +
      '1. Напишите любое сообщение боту ВНУТРИ нужной темы\n' +
      '   (не в "Общие", а именно в теме с логистом)\n' +
      '2. Откройте в браузере:\n' +
      '   api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates\n' +
      '3. Найдите это сообщение, рядом будет поле\n' +
      '   "message_thread_id": <число>\n' +
      '4. Введите это число:',
      ui.ButtonSet.OK_CANCEL
    );
    if (idRes.getSelectedButton() !== ui.Button.OK) return;

    const threadId = idRes.getResponseText().trim();
    if (!threadId || isNaN(Number(threadId))) {
      ui.alert('❌ Введите число (message_thread_id)');
      return;
    }

    let chatId;
    try {
      chatId = getChatId();
    } catch(e) {
      ui.alert('❌ Сначала настройте общий чат:\n⚙️ Настройки → Настроить Telegram');
      return;
    }

    const result = sendMessage(chatId, '✅ Тема подключена!\n\nЗаказы без своего чата поставщика будут приходить сюда.', threadId);
    if (!result.ok) {
      ui.alert(
        '⚠️ Тестовое сообщение не отправилось:\n' + result.description +
        '\n\nПроверьте Thread ID и что бот состоит в супергруппе.'
      );
      return;
    }

    PropertiesService.getScriptProperties().setProperty(PROP_THREAD_ID, threadId);
    ui.alert('✅ Тема подключена!\n\nThread ID: ' + threadId + '\nТестовое сообщение отправлено в неё.');
  }


  function sendMessage(chatId, text, threadId) {
    const token = getBotToken();
    const url   = 'https://api.telegram.org/bot' + token + '/sendMessage';
    try {
      const payload = { chat_id: chatId, text: text, parse_mode: 'HTML' };
      if (threadId) payload.message_thread_id = Number(threadId);

      const response = UrlFetchApp.fetch(url, {
        method:             'post',
        contentType:        'application/json',
        payload:            JSON.stringify(payload),
        muteHttpExceptions: true
      });
      return JSON.parse(response.getContentText());
    } catch(e) {
      return { ok: false, description: e.toString() };
    }
  }

  // ── НОВОЕ: сообщение с inline-кнопками (например, подтверждение заказа хаба) ──
  function sendMessageWithButtons(chatId, text, inlineKeyboard, threadId) {
    const token = getBotToken();
    const url   = 'https://api.telegram.org/bot' + token + '/sendMessage';
    try {
      const payload = {
        chat_id: chatId, text: text, parse_mode: 'HTML',
        reply_markup: { inline_keyboard: inlineKeyboard }
      };
      if (threadId) payload.message_thread_id = Number(threadId);

      const response = UrlFetchApp.fetch(url, {
        method:             'post',
        contentType:        'application/json',
        payload:            JSON.stringify(payload),
        muteHttpExceptions: true
      });
      return JSON.parse(response.getContentText());
    } catch(e) {
      return { ok: false, description: e.toString() };
    }
  }

  // ── НОВОЕ: правка уже отправленного сообщения (после нажатия кнопки) ──
  // inlineKeyboard необязателен — передайте его, чтобы заодно обновить и кнопки
  // под сообщением (например, актуальные количества после ➖/➕).
  function editMessage(chatId, messageId, text, inlineKeyboard) {
    const token = getBotToken();
    const url   = 'https://api.telegram.org/bot' + token + '/editMessageText';
    try {
      const payload = { chat_id: chatId, message_id: messageId, text: text, parse_mode: 'HTML' };
      if (inlineKeyboard) payload.reply_markup = { inline_keyboard: inlineKeyboard };
      const response = UrlFetchApp.fetch(url, {
        method:             'post',
        contentType:        'application/json',
        payload:            JSON.stringify(payload),
        muteHttpExceptions: true
      });
      return JSON.parse(response.getContentText());
    } catch(e) {
      return { ok: false, description: e.toString() };
    }
  }

  // ── НОВОЕ: гасит "часики" на нажатой кнопке в Telegram-клиенте ──
  function answerCallbackQuery(callbackQueryId, text) {
    const token = getBotToken();
    const url   = 'https://api.telegram.org/bot' + token + '/answerCallbackQuery';
    try {
      UrlFetchApp.fetch(url, {
        method:             'post',
        contentType:        'application/json',
        payload:            JSON.stringify({ callback_query_id: callbackQueryId, text: text || '' }),
        muteHttpExceptions: true
      });
    } catch(e) {
      Logger.log('⚠️ answerCallbackQuery: ' + e.toString());
    }
  }

  function sendOrder(orderItems, weekPeriod, officeName) {
    const defaultChatId   = getChatId();
    const defaultThreadId = getDefaultThreadId();
    const supplierChats   = getSupplierChatMap();
    const today  = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM.yyyy');
    const office = officeName || 'Офис';

    const grouped = new Map();
    for (const item of orderItems) {
      const supplier = (item.supplier && item.supplier.toString().trim() !== '')
        ? item.supplier.toString().trim() : '❓ Без поставщика';
      if (!grouped.has(supplier)) grouped.set(supplier, []);
      grouped.get(supplier).push(item);
    }

    const results = [];

    for (const [supplier, items] of grouped.entries()) {
      let text = '🛒 <b>ЗАКАЗ ПРОДУКТОВ</b>\n';
      text += '🏢 ' + office + '\n📅 ' + today;
      if (weekPeriod) text += ' (' + weekPeriod + ')';
      text += '\n' + '─'.repeat(30) + '\n';
      text += '\n📦 <b>' + supplier + '</b>\n';

      for (let i = 0; i < items.length; i++) {
        const item        = items[i];
        const articul     = (item.articul || item.sku || '').toString().trim();
        const articulPart = articul !== '' ? ' [' + articul + ']' : '';
        const unit        = (item.unit || 'шт').toString().trim();
        text += '\n' + (i + 1) + '. <b>' + item.name + '</b>' + articulPart;
        text += '\n   ' + (item.qty || '') + ' ' + unit;
      }
      text += '\n\n📊 Позиций у поставщика: <b>' + items.length + '</b>';

      const hasOwnChat = !!supplierChats[supplier];
      const chatId      = hasOwnChat ? supplierChats[supplier] : defaultChatId;
      const threadId    = hasOwnChat ? null : defaultThreadId; // тема только для общего чата
      if (!hasOwnChat) text += '\n\n📋 <i>Нет своего Telegram — скопируйте и перешлите вручную</i>';

      const result = sendMessage(chatId, text, threadId);
      if (!result.ok) Logger.log('⚠️ Telegram (' + supplier + '): ' + result.description);
      results.push({ supplier, chatId, ok: result.ok });
    }

    const allFailed = results.length > 0 && results.every(r => !r.ok);
    if (allFailed) throw new Error('Ошибка Telegram: сообщения не отправились ни одному поставщику');

    return { ok: true, results };
  }


  function connectChat() {
    const ui = SpreadsheetApp.getUi();

    const tokenResult = ui.prompt(
      '🔗 Настройка Telegram — шаг 1/2',
      'Введите токен вашего бота\n(получите у @BotFather в Telegram):',
      ui.ButtonSet.OK_CANCEL
    );
    if (tokenResult.getSelectedButton() !== ui.Button.OK) return;

    const token = tokenResult.getResponseText().trim();
    if (!token) { ui.alert('❌ Токен не может быть пустым'); return; }

    try {
      const testUrl  = 'https://api.telegram.org/bot' + token + '/getMe';
      const response = UrlFetchApp.fetch(testUrl, { muteHttpExceptions: true });
      const result   = JSON.parse(response.getContentText());
      if (!result.ok) {
        ui.alert('❌ Неверный токен:\n' + (result.description || 'Проверьте токен'));
        return;
      }
      saveBotToken(token);
      Logger.log('✅ Токен проверен: @' + result.result.username);
    } catch(e) {
      ui.alert('❌ Ошибка проверки токена:\n' + e.toString());
      return;
    }

    const chatResult = ui.prompt(
      '🔗 Настройка Telegram — шаг 2/2',
      'Введите Chat ID общего чата (или супергруппы, если у вас темы)\n\n' +
      'Как получить Chat ID:\n' +
      '1. Напишите /start боту в чате\n' +
      '2. Откройте в браузере:\n' +
      'api.telegram.org/bot<ТОКЕН>/getUpdates\n' +
      '3. Найдите "chat":{"id": и скопируйте число:\n\n' +
      'Если общий чат — это ТЕМА внутри супергруппы,\n' +
      'после этого шага зайдите в:\n' +
      '⚙️ Настройки → Telegram → Настроить тему (топик) чата',
      ui.ButtonSet.OK_CANCEL
    );
    if (chatResult.getSelectedButton() !== ui.Button.OK) return;

    const chatId = chatResult.getResponseText().trim();
    if (!chatId) { ui.alert('❌ Chat ID не может быть пустым'); return; }

    PropertiesService.getScriptProperties().setProperty(PROP_CHAT_ID, chatId);
    Logger.log('✅ Chat ID сохранён в PropertiesService: ' + chatId);

    try {
      _saveChatIdToSheet(chatId);
    } catch(e) {
      Logger.log('⚠️ Не удалось записать Chat ID в лист (не критично): ' + e.toString());
    }

    try {
      const testResult = sendMessage(chatId,
        '✅ <b>Telegram подключён!</b>\n\n' +
        'Заказы поставщиков без своего Telegram будут приходить сюда 🛒'
      );
      if (!testResult.ok) throw new Error(testResult.description);
      Logger.log('✅ Тестовое сообщение отправлено');
    } catch(e) {
      ui.alert(
        '⚠️ Chat ID сохранён, но тестовое сообщение не отправилось.\n\n' +
        'Проверьте что бот добавлен в чат и Chat ID верный.\n\n' +
        'Chat ID: ' + chatId + '\nОшибка: ' + e.toString()
      );
      return;
    }

    try { BaseInfo.updateTelegramStatus('✅ Подключён (Chat ID: ' + chatId + ')'); }
    catch(e) { Logger.log('⚠️ updateTelegramStatus: ' + e.toString()); }

    ui.alert(
      '✅ Telegram успешно подключён!\n\n' +
      'Бот: @' + _getBotUsername(token) + '\n' +
      'Chat ID: ' + chatId + '\n\n' +
      'Если это тема внутри супергруппы — не забудьте:\n' +
      '⚙️ Настройки → Telegram → Настроить тему (топик) чата'
    );
  }

  function showStatus() {
    const ui = SpreadsheetApp.getUi();
    try {
      const token    = getBotToken();
      const chatId   = getChatId();
      const threadId = getDefaultThreadId();

      const url      = 'https://api.telegram.org/bot' + token + '/getMe';
      const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
      const result   = JSON.parse(response.getContentText());

      const supplierChats = getSupplierChatMap();
      const supplierCount = Object.keys(supplierChats).length;

      if (result.ok) {
        ui.alert(
          '📡 Статус Telegram\n\n' +
          '✅ Бот активен: @' + result.result.username + '\n' +
          '💬 Общий Chat ID: ' + chatId + '\n' +
          '🧵 Тема (topic): ' + (threadId ? threadId : 'не используется') + '\n' +
          '📦 Поставщиков со своим чатом: ' + supplierCount
        );
      } else {
        ui.alert('❌ Бот недоступен:\n' + result.description);
      }
    } catch(e) {
      ui.alert('❌ Telegram не настроен:\n\n' + e.toString());
    }
  }


  function setupWebhook() {
    const ui = SpreadsheetApp.getUi();
    try {
      const token = getBotToken();

      const webhookUrl = ScriptApp.getService().getUrl();
      if (!webhookUrl) {
        ui.alert(
          '❌ Веб-приложение не опубликовано!\n\n' +
          'Сначала опубликуйте скрипт:\n' +
          '1. Развернуть → Новое развёртывание\n' +
          '2. Тип: Веб-приложение\n' +
          '3. Доступ: Все\n' +
          '4. Скопируйте URL и повторите эту команду'
        );
        return;
      }

      const url      = 'https://api.telegram.org/bot' + token + '/setWebhook';
      const response = UrlFetchApp.fetch(url, {
        method:             'post',
        contentType:        'application/json',
        payload:            JSON.stringify({ url: webhookUrl }),
        muteHttpExceptions: true
      });
      const result = JSON.parse(response.getContentText());

      if (result.ok) {
        ui.alert(
          '✅ Webhook настроен!\n\n' +
          'Теперь бот будет автоматически присылать Chat ID\n' +
          'когда его добавляют в чат.\n\n' +
          'URL: ' + webhookUrl
        );
        Logger.log('✅ Webhook зарегистрирован: ' + webhookUrl);
      } else {
        ui.alert('❌ Ошибка регистрации webhook:\n' + result.description);
      }
    } catch(e) {
      ui.alert('❌ Ошибка: ' + e.toString());
    }
  }


  function _saveChatIdToSheet(chatId) {
    const ss    = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('Базовая информация');
    if (!sheet) {
      Logger.log('⚠️ Лист "Базовая информация" не найден — Chat ID сохранён только в PropertiesService');
      return;
    }

    const data = sheet.getDataRange().getValues();
    for (let i = 0; i < data.length; i++) {
      if (data[i][0] && data[i][0].toString().trim() === 'Chat ID логистики:') {
        sheet.getRange(i + 1, 2).setValue(chatId);
        Logger.log('✅ Chat ID записан в Базовую информацию: ' + chatId);
        return;
      }
    }
    Logger.log('⚠️ Строка "Chat ID логистики:" не найдена в Базовой информации');
  }

  function _getBotUsername(token) {
    try {
      const response = UrlFetchApp.fetch(
        'https://api.telegram.org/bot' + token + '/getMe',
        { muteHttpExceptions: true }
      );
      const result = JSON.parse(response.getContentText());
      return result.ok ? result.result.username : '?';
    } catch(e) { return '?'; }
  }


  return {
    getBotToken,
    saveBotToken,
    getChatId,
    getDefaultThreadId,
    setDefaultThreadId,
    sendMessage,
    sendMessageWithButtons,
    editMessage,
    answerCallbackQuery,
    sendOrder,
    connectChat,
    showStatus,
    setupWebhook
  };

})();
