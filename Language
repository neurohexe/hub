function getLang() {
  return PropertiesService.getDocumentProperties().getProperty(LANG_PROP) === 'en' ? 'en' : 'ru';
}

/** Перевод текста интерфейса на текущий язык. */
function L(ru) {
  return getLang() === 'en' && UI_EN[ru] ? UI_EN[ru] : ru;
}

/** Заголовок колонки склада → русский канон (понимает и RU, и EN). */
function hdrRu_(h) {
  const s = (h == null ? '' : h).toString().trim();
  return WAREHOUSE_HEADERS_RU[s.toLowerCase()] || s;
}

/** Заголовок A1 листа склада на текущем языке. */
function warehouseTitle_(key, today) {
  const name = WAREHOUSE_TYPES[key].name;
  return getLang() === 'en'
    ? L(name) + ' warehouse data as of ' + today
    : 'Данные ' + name.toLowerCase() + ' склада на ' + today;
}

/** Переводит строку 2 (шапку) всех листов складов на текущий язык. */
function applyLanguageToWarehouseHeaders_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const en = getLang() === 'en';
  Object.values(WAREHOUSE_SHEET_NAMES).forEach(name => {
    const sheet = ss.getSheetByName(name);
    if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < 1) return;
    const range = sheet.getRange(2, 1, 1, sheet.getLastColumn());
    const row   = range.getValues()[0];
    let changed = false;
    const out = row.map(v => {
      const ru = hdrRu_(v);
      if (!WAREHOUSE_HEADERS_EN[ru]) return v;
      const target = en ? WAREHOUSE_HEADERS_EN[ru] : ru;
      if (target !== v) changed = true;
      return target;
    });
    if (changed) range.setValues([out]);
  });
}

/** Кнопка переключения языка (пункт меню 🌐). */
function toggleLanguage() {
  const next = getLang() === 'en' ? 'ru' : 'en';
  PropertiesService.getDocumentProperties().setProperty(LANG_PROP, next);
  updateAllWarehouseDates();
  SpreadsheetApp.getActiveSpreadsheet().toast(
    next === 'en' ? 'Reload the page (F5) to switch the menus to English.'
                  : 'Обновите страницу (F5), чтобы меню переключилось на русский.',
    next === 'en' ? '🌐 English' : '🌐 Русский', 8);
}

/** Меню-переключатель: показывает текущий язык, пункт — переключиться на другой. */
function addLanguageMenu_(ui) {
  const en = getLang() === 'en';
  ui.createMenu(en ? '🌐 EN | ru' : '🌐 RU | en')
    .addItem(en ? 'Переключить на русский' : 'Switch to English', 'toggleLanguage')
    .addToUi();
}
